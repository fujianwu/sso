# ─── SSO 认证中心环境变量配置 ────────────────────────────────────────────────
# 复制此文件为 .env，按实际情况填写后重启服务即可。
# 换域名时只需修改 BASE_URL，其余 WebAuthn 字段会自动推断，无需单独改。

# ── 必填 ──────────────────────────────────────────────────────────────────────

# 服务对外访问的根地址（含协议，不带末尾斜杠）
# WebAuthn 的 rpId 和 origin 会自动从此字段提取，换域名只改这一行即可。
BASE_URL=https://sso.sbqs.qzz.io

# 生产环境请使用随机长字符串，可用以下命令生成：
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string

# ── WebAuthn / Passkeys（通常留空，自动从 BASE_URL 推断）────────────────────

# 纯域名，不含协议和端口。留空则自动从 BASE_URL 提取。
# 仅在反向代理无法正确传递 Host 头时才需要显式设置。
WEBAUTHN_RP_ID=

# 完整来源 URL（含协议，不含路径）。留空则自动从 BASE_URL 或请求头构造。
WEBAUTHN_ORIGIN=

# ── Cookie ────────────────────────────────────────────────────────────────────

# HTTPS 部署时必须设为 true，否则 session cookie 无法在浏览器中生效
COOKIE_SECURE=true

# 跨子域名共享 Cookie 时设置父域，例如 .example.com；单域名留空即可
COOKIE_DOMAIN=

# ── 可选 ──────────────────────────────────────────────────────────────────────

# 注册邀请码（留空则无需邀请码）
REGISTRATION_SECRET=

# 数据库路径（默认 SQLite，生产可换为 PostgreSQL 连接串）
DATABASE_URL=sqlite:///./sso_auth.db

# 监听地址与端口
HOST=127.0.0.1
PORT=8200
